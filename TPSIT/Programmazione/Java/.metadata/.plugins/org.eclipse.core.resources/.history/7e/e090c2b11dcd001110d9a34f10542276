package it.asproni.fermi.edu.esercitazione3;

import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.ServerSocket;
import java.net.Socket;
import java.util.Scanner;

public class MyServer {

	public static void main(String[] args) {
		// CREO IL SERVER IN ASCOLTO SULLA PORTA 50000
				ServerSocket serverSocket = new ServerSocket(50000);
				
				System.out.println("Server in esecuzione...");
				
				// METTO IL SERVER IN ATTESA DI RICEVERE UNA CONNESSIONE
				Socket socket = serverSocket.accept();
				
				System.out.println("Client connesso!");
				
				// RECUPERO CANALE PER SCRIVERE AL CLIENT
				OutputStream out = socket.getOutputStream();
				
				// INVIO PRIMO MESSAGGIO
				String messaggio = "Benvenuto nel server";
				out.write(messaggio.getBytes()); 
				
				// INVIO SECONDO MESSAGGIO (CHIESTO ALL'UTENTE)
				Scanner scanner = new Scanner(System.in);
				System.out.println("Dammi messaggio: ");
				String messaggio2 = scanner.nextLine();
				out.write(messaggio2.getBytes());
				
				// INVIO TERZO MESSAGGIO
				String messaggio3 = "Arrivederci";
				out.write(messaggio3.getBytes());
				
				scanner.close();
				out.close();
				socket.close();
				serverSocket.close();
		
	}

}